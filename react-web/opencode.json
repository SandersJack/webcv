{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "docs/FRONTEND_DESIGN_SKILLS.md",
    "docs/FRONTEND_STANDARDS.md"
  ],
  "mcp": {
    "blender": {
      "type": "local",
      "command": [
